{
  "name": "stasya-messenger",
  "version": "1.0.0",
  "description": "Stasya Messenger - полноценный мессенджер с API ботов и звонками (SQLite)",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "nodemon server/index.js",
    "build": "cd client && npm install && npm run build",
    "postinstall": "cd client && npm install"
  },
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.7.2",
    "sql.js": "^1.10.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "uuid": "^9.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express-rate-limit": "^7.1.4",
    "helmet": "^7.1.0"
  },
  "engines": {
    "node": ">=18.0.0 <=20.x"
  }
}
